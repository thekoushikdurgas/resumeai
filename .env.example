# Contact360 GraphQL (resume list/save/delete go through this — no resumeai URL needed for CRUD only)
NEXT_PUBLIC_API_URL=http://api.contact360.io
NEXT_PUBLIC_GRAPHQL_URL=http://api.contact360.io/graphql

# Direct resumeai REST (AI routes: /ai/parse, /ai/enhance, …). Must include /v1. Match SAM deploy URL + /v1.
NEXT_PUBLIC_RESUME_AI_URL=http://127.0.0.1:8080/v1
# Same key as resumeai API_KEY — exposed to the browser; use only in dev or proxy AI via API in production.
NEXT_PUBLIC_RESUME_AI_API_KEY=
