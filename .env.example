APP_ENV=development
DEBUG=true
PORT=8080
LOG_LEVEL=INFO
API_KEY=change-me-in-production
GEMINI_API_KEY=
HF_API_KEY=
AI_PROVIDER=gemini

# Local dev: SQLite. Production: shared Contact360 Postgres (asyncpg)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/contact360
DATABASE_URL=sqlite+aiosqlite:///./resume.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RESET_ON_RETURN=commit

S3_BUCKET_NAME=resume-assets

# s3storage Lambda (resume JSON under resume/ in the user's logical bucket)
LAMBDA_S3STORAGE_API_URL=
LAMBDA_S3STORAGE_API_KEY=
LAMBDA_S3STORAGE_API_TIMEOUT=30

MAX_UPLOAD_SIZE_MB=10
AI_TIMEOUT_SECONDS=120
