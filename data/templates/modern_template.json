      "title": "Experience",
      "required": true,
      "order": 3,
      "fields": [
        "title",
        "company",
        "location",
        "start_date",
        "end_date",
        "description"
      ]
    },
    {
      "name": "education",
      "title": "Education",
      "required": true,
      "order": 4,
      "fields": [
        "degree",
        "school",
        "location",
        "graduation_date",
